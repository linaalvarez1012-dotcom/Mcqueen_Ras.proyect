<sdf version="1.9">
  <world name="world_1">

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
        <direction>-0.5 0.5 -1</direction>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
    </light>

    <model name="ground_plane">
    <static>true</static>
    <link name="link">
        <collision name="collision">
        <geometry>
            <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
            </plane>
        </geometry>
        </collision>
        <visual name="visual">
        <geometry>
            <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
            </plane>
        </geometry>
        <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
        </material>
        </visual>
        </link>
    </model>

    <model name="box">
      <pose>1.5 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 1.2 0.5</size></box></geometry>
          <transparency>0.01</transparency>
          <material>
            <ambient>0.25 0.01 0.01 1</ambient>
            <diffuse>0.40 0.02 0.02 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="box2">
      <pose>1.5 -1 0 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <transparency>0.01</transparency>
          <material>
            <ambient>0.25 0.01 0.01 1</ambient>
            <diffuse>0.40 0.02 0.02 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
          <collision name="c">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="box3">
      <pose>2.5 -1.4 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1</size></box></geometry>
          <transparency>0.01</transparency>
          <material>
            <ambient>0.25 0.01 0.01 1</ambient>
            <diffuse>0.40 0.02 0.02 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>


  
  </world>
</sdf>