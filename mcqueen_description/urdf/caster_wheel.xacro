<?xml version="1.0"?>
<robot name="mcqueen" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <xacro:macro name="caster_wheel" params="name radius mass">
    <link name="${name}">
      <visual>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${2/5 * mass * radius**2}"
                 iyy="${2/5 * mass * radius**2}"
                 izz="${2/5 * mass * radius**2}"
                  ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>


  </xacro:macro>

</robot>