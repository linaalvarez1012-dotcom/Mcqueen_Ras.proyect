<?xml version="1.0"?>
<robot name="mcqueen" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="laser" params="name laser_length laser_radius mass">

    <link name="${name}">
      <visual>
        <geometry>
          <cylinder length="${laser_length}" radius="${laser_radius}"/>
        </geometry>
        <material name="purple"/>
      </visual>

      <collision>
        <geometry>
          <cylinder length="${laser_length}" radius="${laser_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${mass/12 * (3*laser_radius**2 + laser_length**2)}"
                 iyy="${mass/12 * (3*laser_radius**2 + laser_length**2)}"
                 izz="${mass * laser_radius**2 / 2}"
                  ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

  </xacro:macro>


</robot>