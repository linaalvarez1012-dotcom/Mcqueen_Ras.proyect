<?xml version="1.0"?>
<robot name="mcqueen" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="laser" params="name laser_length laser_radius mass">

    <link name="${name}">
      <visual>
        <geometry>
          <cylinder length="${laser_length}" radius="${laser_radius}"/>
        </geometry>
        <material name="purple"/>
      </visual>

      <collision>
        <geometry>
          <cylinder length="${laser_length}" radius="${laser_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${mass/12 * (3*laser_radius**2 + laser_length**2)}"
                 iyy="${mass/12 * (3*laser_radius**2 + laser_length**2)}"
                 izz="${mass * laser_radius**2 / 2}"
                  ixy="0" ixz="0" iyz="0"/>
      </inertial>

    <sensor name='gpu_lidar' type='gpu_lidar'>"
        <pose relative_to='lidar_frame'>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>640</samples>
                    <resolution>1</resolution>
                    <min_angle>-1.396263</min_angle>
                    <max_angle>1.396263</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>0.01</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.08</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
    </sensor>

    </link>
  </xacro:macro>


</robot>